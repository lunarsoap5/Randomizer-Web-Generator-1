  {
    "RoomName": "Eldin Field Near CT",
    "Exits": [
      {
        "ConnectedArea": "Eldin Field",
        "Requirements": "(Room.Kak_Malo_Mart and CanCompleteEldinTwilight and CanCompleteLanayruTwilight) or (Setting.skipBridgeDonation equals True)",
        "GlitchedRequirements": "(Room.Kak_Malo_Mart and CanCompleteEldinTwilight and CanCompleteLanayruTwilight) or (Setting.skipBridgeDonation equals True)"
      },
      {
        "ConnectedArea": "OCT East",
        "Requirements": "true",
        "GlitchedRequirements": "true"
      }
    ],
    "Checks": [
      {
        "CheckName": "Goron Springwater Rush",
        // Note: this check is in the "Eldin Field Near CT" room which takes
        // care of a lot of the logic. The important thing is that paying the initial
        // donation is not a way to logically gain access to Lanayru. Therefore we
        // require that they already have access to the Lanayru side of the bridge to
        // avoid a confusing scenario where the player is expected to build the bridge
        // to do this check but then crossing the bridge would be going out of logic.
        "Requirements": "CanCompleteEldinTwilight and Room.Lower_Kak_Village and ((Setting.skipBridgeDonation equals True) or (Room.Kak_Malo_Mart and ((Setting.walletSize not_equal Reduced) or Progressive_Wallet)))",
        "GlitchedRequirements": "CanCompleteEldinTwilight and Room.Lower_Kak_Village and ((Setting.skipBridgeDonation equals True) or (Room.Kak_Malo_Mart and ((Setting.walletSize not_equal Reduced) or Progressive_Wallet)))"
      }
    ],
    "Region": "Hyrule Field - Eldin Province"
  },
